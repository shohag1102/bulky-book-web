@using Bulky.Models
@model Category

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-12">
            <h3 class="mb-0">Delete Category</h3>
        </div>
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger">
    </div>

    <div class="row">
        <div class="col-12">
            <form method="post">

                <input asp-for="Id" hidden />
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Category Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Enter category name" disabled/>
                </div>

                <div class="mb-3">
                    <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                    <input asp-for="DisplayOrder" class="form-control" placeholder="Enter display order" disabled/>
                </div>

                <div class="row">
                    <div class="col-6">
                        <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary form-control">
                            <i class="bi bi-arrow-left"></i> Go back to lists
                        </a>
                    </div>
                    <div class="col-6">
                        <button type="submit" class="btn btn-danger form-control">
                            <i class="bi bi-check-lg"></i> Delete
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

