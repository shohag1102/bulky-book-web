@using Bulky.Models.Models
@model Product

<div class="container-fluid mt-4">

    <!-- Page Header -->
    <div class="row mb-3">
        <div class="col-12">
            <h3 class="mb-0">Create New Product</h3>
        </div>
    </div>


    <!-- Validation Summary -->
    <div asp-validation-summary="ModelOnly" class="text-danger">
    </div>


    <div class="row">
        <div class="col-12">

            <form method="post">

                <!-- Product Title -->
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">
                        Product Title
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter product title" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>
                </div>


                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Enter product description">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>
                </div>


                <!-- ISBN & Author -->
                <div class="row">

                    <div class="col-md-6">

                        <div class="mb-3">
                            <label asp-for="ISBN" class="form-label">
                                ISBN
                            </label>

                            <input asp-for="ISBN"
                                   class="form-control"
                                   placeholder="Enter ISBN" />

                            <span asp-validation-for="ISBN"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="mb-3">
                            <label asp-for="Author" class="form-label">
                                Author
                            </label>

                            <input asp-for="Author"
                                   class="form-control"
                                   placeholder="Enter author name" />

                            <span asp-validation-for="Author"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                </div>


                <!-- Pricing -->
                <div class="row">

                    <!-- List Price -->
                    <div class="col-md-3">

                        <div class="mb-3">

                            <label asp-for="ListPrice"
                                   class="form-label">
                                List Price
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">$</span>

                                <input asp-for="ListPrice"
                                       class="form-control"
                                       placeholder="0.00" />
                            </div>

                            <span asp-validation-for="ListPrice"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <!-- Price 1-50 -->
                    <div class="col-md-3">

                        <div class="mb-3">

                            <label asp-for="Price"
                                   class="form-label">
                                Price for 1-50
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">$</span>

                                <input asp-for="Price"
                                       class="form-control"
                                       placeholder="0.00" />
                            </div>

                            <span asp-validation-for="Price"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <!-- Price 50+ -->
                    <div class="col-md-3">

                        <div class="mb-3">

                            <label asp-for="Price50"
                                   class="form-label">
                                Price for 50+
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">$</span>

                                <input asp-for="Price50"
                                       class="form-control"
                                       placeholder="0.00" />
                            </div>

                            <span asp-validation-for="Price50"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <!-- Price 100+ -->
                    <div class="col-md-3">

                        <div class="mb-3">

                            <label asp-for="Price100"
                                   class="form-label">
                                Price for 100+
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">$</span>

                                <input asp-for="Price100"
                                       class="form-control"
                                       placeholder="0.00" />
                            </div>

                            <span asp-validation-for="Price100"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>


                <!-- Buttons -->
                <div class="row mt-3">

                    <div class="col-6">

                        <a asp-area="Admin"
                           asp-controller="Product"
                           asp-action="Index"
                           class="btn btn-outline-secondary form-control">

                            <i class="bi bi-arrow-left"></i>
                            Go back to list

                        </a>

                    </div>


                    <div class="col-6">

                        <button type="submit"
                                class="btn btn-primary form-control">

                            <i class="bi bi-check-lg"></i>
                            Create

                        </button>

                    </div>

                </div>

            </form>

        </div>
    </div>

</div>


@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}