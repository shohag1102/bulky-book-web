@using BulkyBookWeb.Models
@model List<Category>

<partial name="_Notification" />

<div class="container mt-4">
    <div class="row align-items-center mb-3">
        <div class="col-6">
            <h3 class="mb-0">Category List</h3>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Category" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-file-earmark-plus-fill"></i> Create New Category
            </a>
        </div>
    </div>

    <table class="table table-striped table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Category Name</th>
                <th>Display Order</th>
                <th class="text-center" style="width: 150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.DisplayOrder</td>
                        <td class="text-center">
                            <a asp-controller="Category" asp-action="Edit" asp-route-catId="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-controller="Category" asp-action="Delete" asp-route-catId="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">No categories found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>